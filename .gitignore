# pixi environments
.pixi/*
!.pixi/config.toml

# SQA run artifacts — point-in-time reports, not project source
tests/reports/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.venv/

# AgentFS session databases (never part of the project)
.agentfs/
session-*.md

# Generated bearer tokens. A token in the repo is a leaked token, and `--generate-token`
# without --token-file drops one in the current directory if you are not paying attention.
/token

# Playwright MCP's own scratch output (console logs, page snapshots) lands in the server's cwd.
.playwright-mcp/
